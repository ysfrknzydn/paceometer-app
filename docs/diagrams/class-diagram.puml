@startuml
skinparam shadowing false
skinparam roundCorner 4
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 50

skinparam class {
  BorderColor #445566
  BackgroundColor #F7F8FC
  ArrowColor #5B6470
  FontColor #2A3540
  AttributeFontColor #4A5460
  StereotypeFontColor #8A6D1E
}

class AuthController <<entry point — js/auth.js>> {
  - mode
  --
  + AuthController()
}

class App <<composition root — js/app.js, not a real class>> #FDF3D8 {
  - zoneState
  - thresholdSeconds
  - nearingThresholdSeconds
  - pendingSaveSummary
  --
  + startApp()
  + stopApp()
  + setViewportZoomEnabled(enabled)
  - handlePosition(position)
  - classifyZone(marginalSeconds, mph, knownLimitMph)
  - startTrip()
  - endTrip()
  - attemptSaveTrip(summary, isRetry)
  - resumeTripIfAny()
}

class GeolocationTracker {
  - watchId
  - lastPosition
  - wakeLock
  --
  + startWatching()
  + stopWatching()
  + requestWakeLock()
  + releaseWakeLock()
  + resetLastPosition()
  + deriveSpeedMph(coords, timestamp): mph
}

class SpeedLimitService {
  - knownLimitMph
  - lastQuery
  - queryInFlight
  - cache
  - devOverrideMph
  --
  + getKnownLimitMph(): mph
  + setDevOverride(mph)
  + clearDevOverride()
  + resetKnownLimit()
  + maybeQuery(coords, timestamp)
}

class Trip {
  - recording
  - trip
  - userId
  - checkpointing
  --
  + isRecording: bool
  + start(userId)
  + recordSample(mph, timestamp, zoneState, limit, vehicle): progress
  + finish(): summary
  + cancel()
  + restoreFrom(checkpoint)
  + {static} readCheckpoint(): checkpoint
  + {static} clearCheckpoint()
}

class DashboardView {
  --
  + setStatus(text, className)
  + setSpeed(mph)
  + setPace(mph)
  + renderZone(state, rounded, limit)
  + flashZoneChange(state)
  + setSpeedLimitSign(limit)
  + setTripZoneProgress(pct, saved)
  + showTripSummary(saved, miles, elapsed, gasCost, gasSaved)
  + hideTripSummary()
  + setViewportZoomEnabled(enabled)
}

class SegmentedSetting {
  - options
  --
  + SegmentedSetting(config)
}

class VehiclePicker {
  - selected
  - variants
  --
  + getSelectedVehicle(): vehicle
}

class SearchableSelect {
  - select
  - input
  --
  + SearchableSelect(selectEl, config)
}

class PasswordToggle {
  - input
  - button
  --
  + PasswordToggle(inputEl, buttonEl)
}

class AudioFeedback {
  - audioCtx
  - muted
  --
  + setMuted(muted)
  + onZoneChange(state)
  + playTripStartTone()
  + playTripEndTone()
}

class SimulatedDrive {
  - interval
  - demoTrip
  --
  + start()
  + stop(restartWatch)
  + setEnabled(enabled)
}

class TripHistory {
  --
  + load()
}

class FeedbackRecorder {
  - mediaRecorder
  - chunks
  - lastRecordingBlob
  --
  + cancel()
}

class GlobalErrorHandler {
  --
  + GlobalErrorHandler(onError)
}

AuthController ..> App : «use» startApp/stopApp/\nsetViewportZoomEnabled
AuthController "1" *-down- "2" PasswordToggle : owns

App "1" *-down- "1" GeolocationTracker : owns
App "1" *-down- "1" SpeedLimitService : owns
App "1" *-down- "1" Trip : owns
App "1" *-down- "1" DashboardView : owns
App "1" *-down- "4" SegmentedSetting : owns
App "1" *-down- "1" VehiclePicker : owns
VehiclePicker "1" *-down- "4" SearchableSelect : owns
App "1" *-down- "1" AudioFeedback : owns
App "1" *-down- "1" SimulatedDrive : owns
App "1" *-down- "1" TripHistory : owns
App "1" *-down- "1" FeedbackRecorder : owns
FeedbackRecorder ..> Trip : «use» isRecording (metadata\nsnapshot only)
App "1" *-down- "1" GlobalErrorHandler : owns
GlobalErrorHandler ..> DashboardView : «use» showGlobalError\n(via onError callback)

SimulatedDrive ..> GeolocationTracker : «use» start/stopWatching,\nresetLastPosition
SimulatedDrive ..> SpeedLimitService : «use» setDevOverride,\nclearDevOverride
SimulatedDrive ..> DashboardView : «use» setSpeedLimitSign,\nsetTripButtonDisabled
SimulatedDrive ..> Trip : «use» isRecording (real trip)
SimulatedDrive "1" *-down- "1" Trip : owns (own demo trip,\nnever the real one)

@enduml
